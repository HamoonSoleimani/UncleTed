<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <!-- Icon Anchor Container with Badge -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Squircle Container with Gradient -->
        <FrameLayout
            android:id="@+id/container_icon_bg"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_icon_banking"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_hp_banking" />
        </FrameLayout>

        <!-- Unread Notification Badge Dot -->
        <View
            android:id="@+id/badge_notification_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="-2dp"
            android:background="@drawable/bg_widget_button_danger"
            android:elevation="6dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- App Label with Shadow -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="Banking"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>