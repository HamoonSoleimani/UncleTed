    <!-- SMS Command Reference Strings -->
    <string name="sms_command_guide_title">SMS Command Guide</string>
    <string name="sms_command_guide_instructions">Send an SMS to this device from any phone using the following format. Replace \"[password]\" with your SMS Command Master Password.</string>
    <string name="sms_command_wipe">UNCLETED WIPE [password]</string>
    <string name="sms_command_wipe_desc">Wipes the device IMMEDIATELY. No evidence is collected to ensure maximum speed of destruction.</string>
    <string name="sms_command_evidence">UNCLETED EVIDENCE [password]</string>
    <string name="sms_command_evidence_desc">Records video, audio, and location. Saves files locally and sends them via Email.</string>
    <string name="sms_command_siren">UNCLETED SIREN [password]</string>
    <string name="sms_command_siren_desc">Triggers a HIGH alert, sends evidence, and activates a loud siren on the device.</string>
    <string name="sms_command_lock">UNCLETED LOCK [password]</string>
    <string name="sms_command_lock_desc">Immediately locks the device and shows the secure PIN entry screen.</string>
    <string name="sms_command_locate">UNCLETED LOCATE [password]</string>
    <string name="sms_command_locate_desc">Forces a high-accuracy GPS fix and sends the location via SMS or Email immediately.</string>
    <string name="sms_command_audio">UNCLETED AUDIO [password] [seconds]</string>
    <string name="sms_command_audio_desc">Silently records ambient audio for the specified seconds (default 60s) and emails the file.</string>
    <string name="sms_command_speak">UNCLETED SPEAK [password] [message]</string>
    <string name="sms_command_speak_desc">Uses Text-to-Speech to read the message aloud at maximum volume.</string>
    <string name="sms_command_reboot">UNCLETED REBOOT [password]</string>
    <string name="sms_command_reboot_desc">(Root Only) Forces the device to reboot immediately.</string>

