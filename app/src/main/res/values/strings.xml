    <!-- Emergency Destruction Protocols -->
    <string name="destruction_title">Emergency Destruction Protocols</string>
    <string name="destruction_desc">Lethal, irreversible data sanitization pipelines bypassing userspace wear-leveling pitfalls via sub-millisecond cryptographic header erasure and JEDEC silicon commands.</string>
    <string name="feature_wipe_device">Wipe Device on Critical Alert (Extreme)</string>
    <string name="feature_hardware_wipe">Rapid Volume Sequence Wipe (VOL UP-DOWN-UP-DOWN)</string>
    <string name="destruction_level_1_title">Level 1: Standard Android Platform Factory Reset</string>
    <string name="destruction_level_1_desc">Invokes RecoverySystem.rebootWipeUserData() or stages BCB command under /cache/recovery/command.</string>
    <string name="destruction_level_2_title">Level 2: Fast Cryptographic Shred (JEDEC BLKSECDISCARD)</string>
    <string name="destruction_level_2_desc">Destroys discrete StrongBox keys, shreds Vold keys, and issues direct JEDEC BLKSECDISCARD IOCTLs to /dev/block/by-name/metadata.</string>
    <string name="destruction_level_3_title">Level 3: OS Suicide (Soft Brick)</string>
    <string name="destruction_level_3_desc">Executes Level 2 cryptographic shred, then zeroes core boot and ramdisk partitions (boot, vendor_boot, init_boot). Requires full firmware reflash.</string>
    <string name="destruction_level_4_title">Level 4: Nuclear Winter (Hard Brick Risk)</string>
    <string name="destruction_level_4_desc">Zeroes partition table headers, boot blocks, and executes low-level kernel SysRq hardware triggers. High risk of permanent hardware brick.</string>
    <string name="destruction_execute_level_1">Execute Level 1: Platform Reset</string>
    <string name="destruction_execute_level_2">Execute Level 2: JEDEC Silicon Shred</string>
    <string name="destruction_execute_level_3">Execute Level 3: OS Suicide (Soft Brick)</string>
    <string name="destruction_execute_level_4">EXECUTE LEVEL 4: NUCLEAR WINTER</string>

