    <string name="pin_guide_title">Operational Credential Matrix Guide</string>
    <string name="pin_guide_normal_title">1. Normal Unlock PIN</string>
    <string name="pin_guide_normal_desc">Authenticates primary user session and resets failed attempt counters.</string>
    <string name="pin_guide_duress_title">2. Duress PIN (Covert Trap)</string>
    <string name="pin_guide_duress_desc">Halts authentication at framework level, displays authentic \'Wrong PIN\' error, and silently captures dual camera photos, room audio, and GPS coordinates.</string>
    <string name="pin_guide_wipe_title">3. Wipe PIN (Silicon Erasure)</string>
    <string name="pin_guide_wipe_desc">Immediately commands discrete HSM to revoke master keys, executes JEDEC silicon discard on FBE headers, and forces reboot into recovery.</string>
    <string name="pin_guide_honeypot_title">4. Honeypot Decoy PIN</string>
    <string name="pin_guide_honeypot_desc">Purges User 0 Credential-Encrypted keys from kernel keyring via Vold, locks User 0 to BFU, and migrates the active session to an isolated secondary Android profile.</string>

    <!-- Silicon & Hardware Sentinels -->
    <string name="hardware_sentinels_title">Silicon &amp; Hardware Sentinels</string>
    <string name="pmic_battery_tamper_title">PMIC Micro-Telemetry &amp; Anti-Disassembly</string>
    <string name="pmic_battery_tamper_desc">Monitors electrochemical battery impedance (R_int) and thermal gradient shock against bench power supply micro-clamp attachment and chassis unsealing.</string>
    <string name="pmic_toggle_label">Enable PMIC Battery Bus Interrogation</string>
    <string name="pmic_recalibrate_button">Lock Current Battery Baseline</string>
    <string name="pmic_impedance_threshold_hint">Impedance Shift Delta (Threshold: 35 mΩ)</string>
    <string name="pmic_thermal_threshold_hint">Thermal Shock Drop (Threshold: 12.0°C)</string>
    <string name="spectral_sentinel_title">Sub-Second Spectral Collapse Sentinel</string>
    <string name="spectral_sentinel_desc">Monitors simultaneous Cellular, Wi-Fi, and GNSS extinction paired with physical micro-motion to detect immediate Faraday bag seizure.</string>
    <string name="spectral_toggle_label">Enable 4-Second Spectral Collapse Trap</string>
    <string name="spectral_window_hint">Extinction Confirmation Window (ms)</string>
    <string name="spectral_motion_required_label">Require Micro-Motion (Anti-Nightstand False-Positive)</string>
    <string name="faraday_blackout_title">180-Minute Autonomous Faraday Sentinel</string>
    <string name="faraday_blackout_desc">Hardware RTC AlarmManager wakeup. Forces automatic BFU key eviction if phone remains isolated in an evidence locker or Faraday container past the limit.</string>
    <string name="faraday_toggle_label">Enable Continuous RF Loss Watchdog</string>
    <string name="faraday_duration_hint">Continuous Isolation Limit (Hours)</string>
    <string name="baseband_sentinel_title">Modem Baseband &amp; IMSI-Catcher Sentinel</string>
    <string name="baseband_sentinel_desc">Permanently strips legacy 2G frequencies at the modem firmware layer and traps impossible high-RSRP / high-Timing Advance Stingray topologies.</string>
    <string name="baseband_2g_mask_toggle">Modem-Level 2G Frequency Masking</string>
    <string name="baseband_sentinel_toggle">Enable Rogue Cell &amp; Timing Advance Trap</string>
    <string name="baseband_timing_advance_hint">Max Timing Advance (Threshold: 30 ~ 2.3km)</string>
    <string name="usb_tripwire_title">Physical USB Bus &amp; Peripheral Sentinel</string>
    <string name="usb_tripwire_desc">Monitors Linux Kernel UDC gadget controller states and physically severs D+/D- lines via USB HAL v1.3+ while locked.</string>
    <string name="usb_tripwire_toggle">Enable Physical USB Data Severing</string>
    <string name="usb_filter_hint">Transients Debounce Filter (Consecutive Hits)</string>

    <!-- Cryptographic Engine & Deniability Vault -->
    <string name="crypto_engine_title">Cryptography &amp; Vaults</string>
    <string name="pqc_title">NIST FIPS 203 Post-Quantum Hybrid Engine</string>
    <string name="pqc_desc">Integrates finalized lattice standard ML-KEM-768 with classical Curve25519 (X25519) combined via HKDF-SHA512 to prevent Harvest Now, Decrypt Later (HNDL) attacks.</string>
    <string name="pqc_toggle_label">Enforce Hybrid Post-Quantum KEM Envelopes</string>
    <string name="pqc_local_pubkey_hint">Local Device Hybrid Public Key (Base64)</string>
    <string name="pqc_remote_pubkey_hint">Trusted Remote Operator Hybrid Public Key (Base64)</string>
    <string name="pqc_generate_keypair_button">Generate New ML-KEM Keypair</string>
    <string name="pqc_copy_pubkey_button">Copy Local Public Key</string>
    <string name="pqc_save_remote_button">Save Trusted Peer Public Key</string>
    <string name="deniability_vault_title">Plausible Deniability Vault (DNG Polyglot)</string>
    <string name="deniability_vault_desc">Compresses sensitive data with Deflate, encrypts via ChaCha20-Poly1305, and shapes entropy (H ~ 7.3) into a structurally valid Adobe DNG RAW camera container.</string>
    <string name="vault_carrier_name_hint">Carrier DNG Image Filename</string>
    <string name="vault_secret_label_hint">Vault Record Label (Anchor Identifier)</string>
    <string name="vault_secret_content_hint">Secret Text Data / Seed to Conceal</string>
    <string name="vault_store_button">Conceal in DNG Container</string>
    <string name="vault_extract_button">Extract &amp; Decrypt Secret</string>
    <string name="vault_purge_button">Permanently Overwrite &amp; Purge Carrier</string>
    <string name="zram_hardening_title">Volatile RAM Scrubbing &amp; ZRAM Re-Keying</string>
    <string name="zram_hardening_desc">Forces kernel pagecache, dentry, and unpinned inode drops on ACTION_SCREEN_OFF and dynamically resets ephemeral swap encryption keys.</string>
    <string name="zram_scrubbing_toggle">Purge Caches on Screen-Off (drop_caches)</string>
    <string name="zram_rekeying_toggle">Ephemeral ZRAM Swap Re-Keying (Root)</string>
    <string name="zram_manual_scrub_button">Execute Volatile Memory Scrubbing Pass</string>

    <!-- Physical Proximity & Dead-Man Tripwires -->
    <string name="proximity_tripwire_title">Proximity &amp; Dead-Man Tripwires</string>
    <string name="ble_proximity_title">BLE/UWB Proximity Key Sharding Engine</string>
    <string name="ble_proximity_desc">Master secrets split into two Shamir 2-of-2 additive shares. Shard A resides in Titan M2; Shard B resides in volatile RAM and evaporates if paired wearable moves &gt; 2m away.</string>
    <string name="ble_proximity_toggle">Enable Shamir 2-of-2 Hardware Separation</string>
    <string name="ble_target_mac_hint">Paired Peripheral BLE MAC Address</string>
    <string name="ble_rssi_threshold_hint">Separation Cutoff RSSI (dBm, Default: -85)</string>
    <string name="ble_breach_limit_hint">Consecutive Heartbeat Breaches (Default: 3)</string>
    <string name="deadman_tripwire_title">Autonomous BFU Dead-Man Sentinel</string>
    <string name="deadman_tripwire_desc">Direct Boot hardware RTC sentinel. Automatically executes cryptographic wipe if the device is isolated, offline, or powered down past the deadline.</string>
    <string name="deadman_toggle_label">Enable Dead-Man Data Destruction Sentinel</string>
    <string name="deadman_duration_hint">Offline Duration to Trigger Wipe</string>
    <string name="deadman_checkin_button">Manual Security Check-In</string>
    <string name="geofence_suicide_title">Multi-Zone Geographic Suicide</string>
    <string name="geofence_suicide_desc">High-precision GPS Ray-Casting algorithm. Triggers instant cryptographic erasure if device breaches user-defined high-risk zones or pre-configured perimeters.</string>
    <string name="geofence_evin_toggle">Evin Prison Perimeter Sentinel (Auto-Wipe)</string>
    <string name="geofence_manage_zones_button">Manage Custom Destruction Zones</string>

