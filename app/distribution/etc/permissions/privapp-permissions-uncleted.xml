<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="com.hamoon.uncleted">
        <!-- Allows calling RecoverySystem.rebootWipeUserData directly -->
        <permission name="android.permission.MASTER_CLEAR"/>

        <!-- Allows triggering instant low-level OS reboots -->
        <permission name="android.permission.REBOOT"/>

        <!-- Allows modifying system-level security databases and settings -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>

        <!-- Allows cross-profile interaction for multi-user/work profile protection -->
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>

        <!-- Allows native multi-user profile creation and honeypot provisioning -->
        <permission name="android.permission.MANAGE_USERS"/>

        <!-- Allows expanding/collapsing system bars and status bar services -->
        <permission name="android.permission.STATUS_BAR_SERVICE"/>

        <!-- Grants access to usage analytics for behavioral threat detection -->
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>

        <!-- Grants access to physical USB controller status and management -->
        <permission name="android.permission.MANAGE_USB"/>

        <!-- Allows managing device admin policies without framework permission denial -->
        <permission name="android.permission.MANAGE_DEVICE_ADMINS"/>
    </privapp-permissions>
</permissions>
